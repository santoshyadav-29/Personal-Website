# -----------------------------------------------------------------------------
# Site (Astro) — copy to `.env` / `.env.local` for local development
# -----------------------------------------------------------------------------

# Public Convex client URL (from `npx convex dev` / dashboard). Required.
PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Convex HTTP Actions URL (.site for cloud, :3211 for local). Required for
# private file preview/download in the admin UI.
PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Canonical site origin (sitemap, RSS, Open Graph). Use your real domain in prod.
PUBLIC_SITE_URL=http://localhost:4321

# Optional alias read by astro.config.mjs if PUBLIC_SITE_URL is unset.
SITE_URL=http://localhost:4321

# Written automatically by `npx convex dev` / `npx convex init` — do not commit.
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent
# CONVEX_URL=http://127.0.0.1:3210
# CONVEX_SITE_URL=http://127.0.0.1:3211

# -----------------------------------------------------------------------------
# Convex deployment environment variables
# Set these on the Convex deployment (dashboard or `npx convex env set`):
#
#   JWT_PRIVATE_KEY   — PKCS8 private key (single line, spaces for newlines)
#   JWKS              — JSON JWKS public key set for Convex Auth
#   SITE_URL          — browser origin of the Astro site (OAuth redirects)
#   ADMIN_EMAIL       — Santosh's email; that signed-in user is treated as admin
#
# Optional OAuth (omit to hide those buttons):
#   AUTH_GITHUB_ID
#   AUTH_GITHUB_SECRET
#   AUTH_GOOGLE_ID
#   AUTH_GOOGLE_SECRET
#
# Generate JWT keys with:
#   node --input-type=module -e "import {exportJWK,exportPKCS8,generateKeyPair} from 'jose'; \
#     const k=await generateKeyPair('RS256',{extractable:true}); \
#     const pk=await exportPKCS8(k.privateKey); const jwk=await exportJWK(k.publicKey); \
#     console.log('JWT_PRIVATE_KEY=\"'+pk.trimEnd().replace(/\n/g,' ')+'\"'); \
#     console.log('JWKS='+JSON.stringify({keys:[{use:'sig',...jwk}]}));"
# -----------------------------------------------------------------------------
