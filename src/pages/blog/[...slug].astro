---
import Layout from "../../layouts/Layout.astro";
import BlogPostApp from "../../components/react/BlogPostApp";

export const prerender = false;

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam)
  ? slugParam.join("/")
  : (slugParam ?? "").replace(/\/$/, "");
---

<Layout title="Blog" description="Blog post by Santosh Yadav">
  <BlogPostApp client:load slug={slug} />
</Layout>
