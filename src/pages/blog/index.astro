---
import Layout from "../../layouts/Layout.astro";
import BlogListApp from "../../components/react/BlogListApp";
---

<Layout title="Blog" description="Blog posts by Santosh Yadav">
  <main class="blog-page">
    <h1>Experiences, lessons & more 📖</h1>
    <hr />
    <BlogListApp client:load />
  </main>
</Layout>

<style>
  .blog-page {
    margin-top: 4rem;
  }

  .blog-page h1 {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
</style>
