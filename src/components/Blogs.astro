---
import { getCollection } from "astro:content";
const posts = await getCollection("blog");
// filter only three
const blogs = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

---

<div class="blogs">
  <ul>
    <li><b>Recent Blogs</b></li>
    <li class="blog">
      {
          blogs.map((item) => (
              
          <p>
                  <a href={`/blog/${item.id}/`}>
                      {item.data.title}
                  </a>
                 
                      {item.data.description.slice(0, 100)}...
                    </p>
                    <hr/>
                 
               
              
          ))
      }
    </li>
  </ul>
</div>

  
  <style>
   
    .blogs {
    }
  
    .blogs ul {
      display: grid;
      grid-template-columns: 1fr 3fr;
    }
  
    .blogs ul a {
      font-weight: 500;
      text-decoration: none;
    }


   

    .blog p {
        display: flex;
        flex-direction: column;
    }
  </style>
  